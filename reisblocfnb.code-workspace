{
  "folders": [
    {
      "name": "reisblocfnb",
      "path": "."
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "dev",
        "type": "shell",
        "command": "npm",
        "args": ["run", "dev"],
        "group": "build",
        "problemMatcher": []
      },
      {
        "label": "build",
        "type": "shell",
        "command": "npm",
        "args": ["run", "build"],
        "group": "build",
        "problemMatcher": []
      },
      {
        "label": "lint",
        "type": "shell",
        "command": "npm",
        "args": ["run", "lint"],
        "group": "test",
        "problemMatcher": []
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "bradlc.vscode-tailwindcss",
      "esbenp.prettier-vscode",
      "github.vscode-github-actions"
    ]
  }
}