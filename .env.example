# ==============================================================================
# REISBLOC F&B - VARIABLES DE ENTORNO
# ==============================================================================

# Supabase (Público / Client-side)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Multi-tenant Configuration (Sin hardcoding)
VITE_EVENT_ORGANIZATION_ID=YOUR_ORGANIZATION_UUID
VITE_CLIENT_NAME=LOCALITO
VITE_CLIENT_TAGLINE=GUISOS & BARRA FRÍA
VITE_CLIENT_SUBDOMAIN=localito.reisbloc.com
VITE_LOGO_URL=/logo_localito.jpg

# Administradores Globales (separados por comas)
VITE_ADMIN_EMAILS=admin@localito.reisbloc.com,airproject360@gmail.com

# Pasarelas de Pago (Opcionales / Tokens públicos y referencias)
VITE_MERCADOPAGO_ACCESS_TOKEN=
VITE_CLIP_API_KEY=
VITE_CLIP_MERCHANT_ID=
VITE_CLIP_BASE_URL=https://api.clip.mx/v1

# Servidor / Edge Functions (NUNCA exponer en cliente público)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
JWT_SECRET=YOUR_JWT_SECRET_KEY
